# --- environment -------------------------------------------------------
.venv/
__pycache__/
*.pyc

# --- client data: never commit -----------------------------------------
# The source plansets are client drawings. The exported dataset under
# out/dataset/ is committed deliberately (it is the training set), so keep
# this repository PRIVATE.
all_plansets/
all_plansets.zip
dataset-creator/data/

# --- model weights (large, and reproducible) ---------------------------
*.pt
*.onnx
*.engine

# --- generated output --------------------------------------------------
# Everything under out/ is derived except the exported dataset, which is
# whitelisted below.
out/*
!out/dataset/
out/dataset/*/bench/
out/dataset/*/runs/
out/dataset/*/_overfit/
out/dataset/*/eval_preview/
out/dataset/*/crops/
out/dataset/*/preview/
out/dataset/*/labels.cache
# The stage-1 region dataset, same reasoning as the stage-2 one above: it is the
# training set, and the GPU box has no plansets to regenerate it from.
!out/regions/
out/regions/*/runs/
out/regions/*/_overfit/
out/regions/*/labels.cache
# r1 was superseded by r2, which excludes areas added after a sheet was verified.
out/regions/r1/

# 300MB of rendered page PNGs, regenerable with `cli viewer --no-serve`
viewer/pages/

# Annotator undo history: 29MB, and the current JSON is the source of truth
annotations/.history/

*.tgz

# CV fold artifacts. The list files hold ABSOLUTE paths (ultralytics resolves a
# leading "./" against the txt file's own directory, which is wrong one level
# down), so they are machine-specific and must not be committed. All of it is
# regenerable: make_folds.py then run_cv.py. Only the measured summary is kept.
out/dataset/*/cv/*
!out/dataset/*/cv/cv_*.json
